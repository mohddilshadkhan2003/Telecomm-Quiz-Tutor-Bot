import json
import os
import re
from typing import Any, Dict, List

import numpy as np

DATA_FILE = os.path.join(os.path.dirname(__file__), "data", "plan_details.json")


def normalize_text(text: str) -> str:
    text = text.lower().strip()
    text = re.sub(r"[^a-z0-9\s]", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def tokenize(text: str) -> List[str]:
    return [token for token in normalize_text(text).split() if token]


def score_answer(user_answer: str, correct_answer: str) -> float:
    if not user_answer or not correct_answer:
        return 0.0

    user_tokens = set(tokenize(user_answer))
    target_tokens = set(tokenize(correct_answer))
    if not target_tokens:
        return 0.0

    overlap = len(user_tokens & target_tokens)
    phrase_bonus = 1.0 if correct_answer.lower() in user_answer.lower() else 0.0
    base_score = (overlap / len(target_tokens)) * 100
    final_score = min(100.0, base_score + (25.0 if phrase_bonus else 0.0))
    return round(final_score, 2)


def load_knowledge_base(path: str = DATA_FILE) -> Dict[str, Any]:
    with open(path, "r", encoding="utf-8") as json_file:
        return json.load(json_file)


def text_to_embedding(text: str) -> np.ndarray:
    normalized = normalize_text(text)
    vector = np.zeros(300, dtype=float)
    for index, token in enumerate(normalized.split(), start=1):
        token_value = sum(ord(ch) for ch in token)
        vector[index % 300] += token_value
    if np.linalg.norm(vector) == 0:
        return vector
    return vector / np.linalg.norm(vector)


def build_vector_db(plan_contents: List[Dict[str, Any]]) -> "InMemoryVectorDB":
    from vector_db import InMemoryVectorDB

    store = InMemoryVectorDB()
    for plan in plan_contents:
        content = plan.get("content", "")
        title = plan.get("title", "")
        metadata = {
            "id": plan.get("id"),
            "title": title,
            "content": content,
            "keywords": plan.get("keywords", []),
        }
        embedding = text_to_embedding(f"{title}. {content}")
        store.add(metadata, embedding)
    return store


def retrieve_context(store: "InMemoryVectorDB", question: str, top_k: int = 3) -> List[Dict[str, Any]]:
    if not question.strip():
        return []
    query_embedding = text_to_embedding(question)
    results = store.search(query_embedding, top_k=top_k)
    return [result[0] for result in results]


def build_context_text(context_docs: List[Dict[str, Any]]) -> str:
    segments = []
    for doc in context_docs:
        title = doc.get("title", "Unknown")
        content = doc.get("content", "")
        segments.append(f"Title: {title}\nContent: {content}")
    return "\n\n".join(segments)



