import os
from typing import Optional

try:
    from openai import OpenAI
except ImportError:
    OpenAI = None


def get_openai_api_key() -> Optional[str]:
    return os.environ.get("OPENAI_API_KEY")


class LLMClient:
    def __init__(self, model: str = "gpt-4o-mini"):
        self.model = model
        self.api_key = get_openai_api_key()
        self.client = None
        if OpenAI is not None and self.api_key:
            self.client = OpenAI(api_key=self.api_key)

    def evaluate_answer(
        self,
        question: str,
        user_answer: str,
        correct_answer: str,
        explanation: str,
        context: str,
    ) -> str:
        if not self.client:
            return self._fallback_evaluation(question, user_answer, correct_answer, explanation, context)

        prompt = (
            "You are a telecom training assistant. Evaluate the learner's answer. "
            "Return a clear score, explain whether it is correct, and highlight the key telecom concept. "
            "Use the provided context and explanation.\n\n"
            f"Question: {question}\n"
            f"Learner Answer: {user_answer}\n"
            f"Correct Answer: {correct_answer}\n"
            f"Context: {context}\n"
            f"Key Explanation: {explanation}\n"
        )

        try:
            response = self.client.chat.completions.create(
                model=self.model,
                messages=[
                    {"role": "system", "content": "You are a helpful telecom education assistant."},
                    {"role": "user", "content": prompt},
                ],
                temperature=0.2,
                max_tokens=300,
            )
            return response.choices[0].message.content.strip()
        except Exception:
            return self._fallback_evaluation(question, user_answer, correct_answer, explanation, context)

    @staticmethod
    def _fallback_evaluation(
        question: str,
        user_answer: str,
        correct_answer: str,
        explanation: str,
        context: str,
    ) -> str:
        if correct_answer.lower() in user_answer.lower():
            score = 90
            detail = (
                "Your answer matches the expected telecom concept well. "
                "Review the context for deeper understanding and additional product details."
            )
        else:
            score = 45
            detail = (
                "The answer does not yet match the expected plan detail. "
                "Focus on the plan's features, coverage, pricing, or service attributes."
            )

        return (
            "Evaluation:\n"
            f"Score: {score}/100\n"
            f"Correct Answer: {correct_answer}\n"
            f"Feedback: {detail}\n"
            f"Explanation: {explanation}\n"
            f"Context: {context}"
        )



