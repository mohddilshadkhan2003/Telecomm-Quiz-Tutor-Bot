    <script>
      const questions = JSON.parse('{{ questions|safe }}');
      let currentIndex = 0;

      const questionCounter = document.getElementById('question-counter');
      const questionText = document.getElementById('question-text');
      const optionsContainer = document.getElementById('options-container');
      const answerInput = document.getElementById('answer-input');
      const resultCard = document.getElementById('result-card');
      const resultText = document.getElementById('result-text');
      const snippets = document.getElementById('snippets');
      const scoreBadge = document.getElementById('score-badge');

      function renderQuestion() {
        const question = questions[currentIndex];
        questionCounter.textContent = `Question ${currentIndex + 1} of ${questions.length}`;
        questionText.textContent = question.question;
        optionsContainer.innerHTML = question.options
          .map(
            (option, index) =>
              `<button type="button" class="option-button" data-value="${option}">${index + 1}. ${option}</button>`
          )
          .join('');
        answerInput.value = '';
        resultCard.classList.add('hidden');
      }

      optionsContainer.addEventListener('click', (event) => {
        const button = event.target.closest('.option-button');
        if (!button) return;
        answerInput.value = button.dataset.value;
      });

      document.getElementById('prev-question').addEventListener('click', () => {
        currentIndex = Math.max(0, currentIndex - 1);
        renderQuestion();
      });

      document.getElementById('next-question').addEventListener('click', () => {
        currentIndex = Math.min(questions.length - 1, currentIndex + 1);
        renderQuestion();
      });

      document.getElementById('quiz-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const question = questions[currentIndex];
        const userAnswer = answerInput.value.trim();
        if (!userAnswer) {
          alert('Please enter an answer or choose an option.');
          return;
        }

        const submitButton = document.getElementById('submit-answer');
        submitButton.disabled = true;
        submitButton.textContent = 'Checking...';

        const response = await fetch('/evaluate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question_id: question.id, user_answer: userAnswer }),
        });

        const data = await response.json();

        if (data.error) {
          resultText.textContent = data.error;
          resultCard.classList.remove('hidden');
          submitButton.disabled = false;
          submitButton.textContent = 'Submit Answer';
          return;
        }

        const scoreValue = Number(data.score || 0);
        scoreBadge.textContent = `${scoreValue.toFixed(0)}/100`;
        scoreBadge.classList.toggle('high', scoreValue >= 70);
        scoreBadge.classList.toggle('mid', scoreValue >= 40 && scoreValue < 70);
        scoreBadge.classList.toggle('low', scoreValue < 40);

        resultText.textContent = data.evaluation;
        snippets.innerHTML = data.snippet_cards
          .map(
            (item) =>
              `<div class="snippet"><strong>${item.title}</strong><p>${item.content}</p></div>`
          )
          .join('');
        resultCard.classList.remove('hidden');

        submitButton.disabled = false;
        submitButton.textContent = 'Submit Answer';
      });

      document.getElementById('start-quiz').addEventListener('click', () => {
        window.scrollTo({ top: document.querySelector('.quiz-card').offsetTop - 20, behavior: 'smooth' });
      });

      renderQuestion();
    </script>
